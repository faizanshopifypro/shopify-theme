50%) scale(1);\n    background-color:inherit;\n    opacity:.6;\n    animation:st_pulse 1.4s cubic-bezier(0,0,0.2,1) infinite;\n  }\n  @keyframes st_pulse {\n    0%{transform:translate(-50%,-50%) scale(1);opacity:.6;}\n    60%{transform:translate(-50%,-50%) scale(2.8);opacity:0;}\n    100%{transform:translate(-50%,-50%) scale(2.8);opacity:0;}\n  }\n\n  @media (prefers-reduced-motion:reduce){\n    .st_inventory-dot::after{animation:none;opacity:1;}\n  }\n\n  .st_appblock_wrapper{margin-bottom:0;}\n<\/style>\n\n<div class=\"st_appblock_wrapper\" id=\"cj-stock-root\">\n  <div id=\"cj-stock\" class=\"st_inventory-wrapper\">\n    <span class=\"st_inventory-dot\"><\/span>\n    <span class=\"st_inventory-text\"><\/span>\n  <\/div>\n<\/div>\n\n<script>\n(function(){\n  const THRESHOLD=2;\n  const VARIANTS={{ product.variants | json }};\n  const BY_ID=Object.fromEntries(VARIANTS.map(v=>[String(v.id),v]));\n  const INVENTORY_BY_ID={\n    {% for vv in product.variants %}\n      \"{{ vv.id }}\":{% if vv.inventory_quantity != nil %}{{ vv.inventory_quantity }}{% else %}null{% endif %}{% unless forloop.last %},{% endunless %}\n    {% endfor %}\n  };\n  const INITIAL_ID={{ v.id | json }};\n  const wrap=document.getElementById('cj-stock');\n  const text=wrap.querySelector('.st_inventory-text');\n\n  function currentId(){\n    const el=document.querySelector('select[name=\"id\"],input[name=\"id\"]:checked,input[type=\"hidden\"][name=\"id\"]');\n    if(el&&el.value)return String(el.value);\n    const urlId=new URLSearchParams(location.search).get('variant');\n    if(urlId)return String(urlId);\n    return String(INITIAL_ID);\n  }\n\n  function renderById(id){\n    const base=BY_ID[id]||{id,available:true,inventory_policy:'deny',inventory_management:'shopify'};\n    if(typeof base.inventory_quantity!=='number'&&Object.prototype.hasOwnProperty.call(INVENTORY_BY_ID,id)){\n      base.inventory_quantity=INVENTORY_BY_ID[id];\n    }\n    wrap.classList.remove('available','limited','sold_out');\n    text.style.opacity=0;\n    setTimeout(()=>{\n      if(!base||!base.available){\n        wrap.classList.add('sold_out');\n        text.textContent='Bald wieder verfügbar!';\n      }else{\n        const tracked=!!base.inventory_management;\n        const cont=base.inventory_policy==='continue';\n        const qty=base.inventory_quantity;\n        const isLow=(tracked&&!cont&&typeof qty==='number'&&qty<=THRESHOLD);\n        if(isLow){\n          wrap.classList.add('limited');\n          text.textContent='Fast ausverkauft – jetzt bestellen!';\n        }else{\n          wrap.classList.add('available');\n          text.textContent='Heute bestellt - in 1–3 Tagen bei dir!';\n        }\n      }\n      text.style.opacity=1;\n    },120);\n  }\n\n  let last=null;\n  function tick(){\n    const id=currentId();\n    if(id!==last){last=id;renderById(id);}\n    if(!text.textContent)renderById(last||currentId());\n  }\n\n  tick();\n  document.addEventListener('change',()=>tick(),true);\n  document.addEventListener('input',()=>tick(),true);\n  document.addEventListener('click',()=>setTimeout(()=>tick(),0),true);\n  const _ps=history.pushState,_rs=history.replaceState;\n  history.pushState=function(){_ps.apply(this,arguments);setTimeout(()=>tick(),0);};\n  history.replaceState=function(){_rs.apply(this,arguments);setTimeout(()=>tick(),0);};\n  window.addEventListener('popstate',()=>tick());\n  const mo=new MutationObserver(()=>setTimeout(()=>tick(),0));\n  mo.observe(document.documentElement,{childList:true,subtree:true});\n  setInterval(()=>tick(),400);\n})();\n<\/script>"}},"variant_picker":{"type":"variant_picker","settings":{"picker_type":"button","var_heading":"#6e7191","active_variant_bg":"#ff8080","active_variant_color":"#ffffff","variant_bg":"#415b80","variant_color":"#ffffff"}},"quantity_selector":{"type":"quantity_selector","settings":{"quantity_heading":"#6e7191"}},"buy_buttons":{"type":"buy_buttons","settings":{"show_dynamic_checkout":false,"show_gift_card_recipient