{% doc %}
  @prompt
    ich brauche eine section wo nur ein produkt vorgestellt wird für einen one shop produkt store, da fehlt unten noch ein button, der button muss unter dem text sein und das bild muss anklickabr sein
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-single-product-showcase-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.section_bg_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-single-product-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-single-product-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.grid_gap }}px;
    align-items: center;
  }

  .ai-single-product-image-link-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    text-decoration: none;
  }

  .ai-single-product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-single-product-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
    object-fit: cover;
  }

  .ai-single-product-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f5fb;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-single-product-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-single-product-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #6e7191;
    text-align: center;
    pointer-events: none;
  }

  .ai-single-product-content-{{ ai_gen_id }} {
    padding: 0 {{ block.settings.content_padding }}px;
  }

  .ai-single-product-vendor-{{ ai_gen_id }} {
    font-size: {{ block.settings.vendor_font_size }}px;
    color: {{ block.settings.vendor_color }};
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-single-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px;
    line-height: 1.2;
  }

  .ai-single-product-price-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .ai-single-product-price-regular-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_font_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: 600;
  }

  .ai-single-product-price-compare-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_font_size | minus: 4 }}px;
    color: {{ block.settings.compare_price_color }};
    text-decoration: line-through;
  }

  .ai-single-product-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_font_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
    margin-bottom: 30px;
  }

  .ai-single-product-form-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-single-product-variants-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-single-product-variant-label-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.title_color }};
    font-weight: 600;
    margin-bottom: 8px;
  }

  .ai-single-product-variant-options-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .ai-single-product-variant-option-{{ ai_gen_id }} {
    padding: 10px 20px;
    border: 2px solid {{ block.settings.variant_border_color }};
    border-radius: {{ block.settings.variant_border_radius }}px;
    background-color: {{ block.settings.variant_bg_color }};
    color: {{ block.settings.variant_text_color }};
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 14px;
  }

  .ai-single-product-variant-option-{{ ai_gen_id }}:hover {
    border-color: {{ block.settings.variant_hover_border_color }};
    background-color: {{ block.settings.variant_hover_bg_color }};
  }

  .ai-single-product-variant-option-{{ ai_gen_id }}.active {
    border-color: {{ block.settings.variant_active_border_color }};
    background-color: {{ block.settings.variant_active_bg_color }};
    color: {{ block.settings.variant_active_text_color }};
  }

  .ai-single-product-quantity-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-single-product-quantity-label-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.title_color }};
    font-weight: 600;
  }

  .ai-single-product-quantity-selector-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    border: 2px solid {{ block.settings.quantity_border_color }};
    border-radius: {{ block.settings.quantity_border_radius }}px;
    overflow: hidden;
  }

  .ai-single-product-quantity-button-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    border: none;
    background-color: {{ block.settings.quantity_button_bg }};
    color: {{ block.settings.quantity_button_color }};
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-single-product-quantity-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.quantity_button_hover_bg }};
    color: {{ block.settings.quantity_button_hover_color }};
  }

  .ai-single-product-quantity-input-{{ ai_gen_id }} {
    width: 60px;
    height: 40px;
    border: none;
    text-align: center;
    font-size: 16px;
    color: {{ block.settings.title_color }};
    background-color: {{ block.settings.quantity_input_bg }};
  }

  .ai-single-product-buttons-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-single-product-add-to-cart-{{ ai_gen_id }} {
    width: 100%;
    padding: 16px 32px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-single-product-add-to-cart-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-single-product-add-to-cart-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-single-product-secondary-button-{{ ai_gen_id }} {
    width: 100%;
    padding: 16px 32px;
    background-color: {{ block.settings.secondary_button_bg_color }};
    color: {{ block.settings.secondary_button_text_color }};
    border: 2px solid {{ block.settings.secondary_button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .ai-single-product-secondary-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.secondary_button_hover_bg_color }};
    color: {{ block.settings.secondary_button_hover_text_color }};
    border-color: {{ block.settings.secondary_button_hover_border_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-single-product-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .ai-single-product-content-{{ ai_gen_id }} {
      padding: 0;
    }

    .ai-single-product-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<single-product-showcase-{{ ai_gen_id }}
  class="ai-single-product-showcase-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-single-product-container-{{ ai_gen_id }}">
    {% if block.settings.product != blank %}
      {% assign product = block.settings.product %}
      <div class="ai-single-product-grid-{{ ai_gen_id }}">
        <div class="ai-single-product-image-wrapper-{{ ai_gen_id }}">
          {% if product.featured_image %}
            <a href="{{ product.url }}" class="ai-single-product-image-link-{{ ai_gen_id }}">
              <img
                src="{{ product.featured_image | image_url: width: 1000 }}"
                alt="{{ product.featured_image.alt | escape }}"
                loading="lazy"
                width="{{ product.featured_image.width }}"
                height="{{ product.featured_image.height }}"
                class="ai-single-product-image-{{ ai_gen_id }}"
              >
            </a>
          {% else %}
            <div class="ai-single-product-image-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>

        <div class="ai-single-product-content-{{ ai_gen_id }}">
          {% if block.settings.show_vendor and product.vendor != blank %}
            <div class="ai-single-product-vendor-{{ ai_gen_id }}">{{ product.vendor }}</div>
          {% endif %}

          <h2 class="ai-single-product-title-{{ ai_gen_id }}">{{ product.title }}</h2>

          <div class="ai-single-product-price-{{ ai_gen_id }}">
            <span class="ai-single-product-price-regular-{{ ai_gen_id }}">
              {{ product.price | money }}
            </span>
            {% if product.compare_at_price > product.price %}
              <span class="ai-single-product-price-compare-{{ ai_gen_id }}">
                {{ product.compare_at_price | money }}
              </span>
            {% endif %}
          </div>

          {% if block.settings.show_description and product.description != blank %}
            <div class="ai-single-product-description-{{ ai_gen_id }}">
              {{ product.description | truncate: 200 }}
            </div>
          {% endif %}

          {% form 'product', product, class: 'ai-single-product-form-' | append: ai_gen_id %}
            {% if product.variants.size > 1 %}
              <div class="ai-single-product-variants-{{ ai_gen_id }}">
                {% for option in product.options_with_values %}
                  <div>
                    <label class="ai-single-product-variant-label-{{ ai_gen_id }}">
                      {{ option.name }}
                    </label>
                    <div class="ai-single-product-variant-options-{{ ai_gen_id }}">
                      {% for value in option.values %}
                        <button
                          type="button"
                          class="ai-single-product-variant-option-{{ ai_gen_id }}"
                          data-option-position="{{ option.position }}"
                          data-option-value="{{ value | escape }}"
                        >
                          {{ value }}
                        </button>
                      {% endfor %}
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% endif %}

            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

            {% if block.settings.show_quantity %}
              <div class="ai-single-product-quantity-{{ ai_gen_id }}">
                <span class="ai-single-product-quantity-label-{{ ai_gen_id }}">Menge</span>
                <div class="ai-single-product-quantity-selector-{{ ai_gen_id }}">
                  <button
                    type="button"
                    class="ai-single-product-quantity-button-{{ ai_gen_id }}"
                    data-action="decrease"
                  >
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <path d="M3 8H13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                  </button>
                  <input
                    type="number"
                    name="quantity"
                    value="1"
                    min="1"
                    class="ai-single-product-quantity-input-{{ ai_gen_id }}"
                  >
                  <button
                    type="button"
                    class="ai-single-product-quantity-button-{{ ai_gen_id }}"
                    data-action="increase"
                  >
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <path d="M8 3V13M3 8H13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                  </button>
                </div>
              </div>
            {% endif %}

            <div class="ai-single-product-buttons-{{ ai_gen_id }}">
              <button
                type="submit"
                class="ai-single-product-add-to-cart-{{ ai_gen_id }}"
                {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
              >
                {% if product.selected_or_first_available_variant.available %}
                  {{ block.settings.button_text }}
                {% else %}
                  Ausverkauft
                {% endif %}
              </button>

              {% if block.settings.show_secondary_button and block.settings.secondary_button_link != blank %}
                <a
                  href="{{ block.settings.secondary_button_link }}"
                  class="ai-single-product-secondary-button-{{ ai_gen_id }}"
                >
                  {{ block.settings.secondary_button_text }}
                </a>
              {% endif %}
            </div>
          {% endform %}
        </div>
      </div>
    {% else %}
      <div class="ai-single-product-grid-{{ ai_gen_id }}">
        <div class="ai-single-product-image-wrapper-{{ ai_gen_id }}">
          <div class="ai-single-product-image-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
            <div class="ai-single-product-empty-state-{{ ai_gen_id }}">
              Wählen Sie ein Produkt aus
            </div>
          </div>
        </div>
        <div class="ai-single-product-content-{{ ai_gen_id }}">
          <div class="ai-single-product-vendor-{{ ai_gen_id }}">Markenname</div>
          <h2 class="ai-single-product-title-{{ ai_gen_id }}">Produktname</h2>
          <div class="ai-single-product-price-{{ ai_gen_id }}">
            <span class="ai-single-product-price-regular-{{ ai_gen_id }}">€29,99</span>
          </div>
          <div class="ai-single-product-description-{{ ai_gen_id }}">
            Hier wird die Produktbeschreibung angezeigt. Wählen Sie ein Produkt aus, um die Details anzuzeigen.
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</single-product-showcase-{{ ai_gen_id }}>

<script>
  (function() {
    class SingleProductShowcase{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.form = this.querySelector('.ai-single-product-form-{{ ai_gen_id }}');
        if (!this.form) return;

        this.variantInput = this.form.querySelector('input[name="id"]');
        this.variantButtons = this.querySelectorAll('.ai-single-product-variant-option-{{ ai_gen_id }}');
        this.quantityInput = this.querySelector('.ai-single-product-quantity-input-{{ ai_gen_id }}');
        this.quantityButtons = this.querySelectorAll('.ai-single-product-quantity-button-{{ ai_gen_id }}');
        this.addToCartButton = this.querySelector('.ai-single-product-add-to-cart-{{ ai_gen_id }}');

        this.setupVariantSelection();
        this.setupQuantityControls();
      }

      setupVariantSelection() {
        if (this.variantButtons.length === 0) return;

        const firstButtons = {};
        this.variantButtons.forEach((button) => {
          const position = button.dataset.optionPosition;
          if (!firstButtons[position]) {
            button.classList.add('active');
            firstButtons[position] = button;
          }

          button.addEventListener('click', (e) => {
            const clickedButton = e.currentTarget;
            const position = clickedButton.dataset.optionPosition;

            this.querySelectorAll(`[data-option-position="${position}"]`).forEach((btn) => {
              btn.classList.remove('active');
            });

            clickedButton.classList.add('active');
            this.updateVariant();
          });
        });
      }

      updateVariant() {
        const selectedOptions = [];
        const positions = new Set();

        this.variantButtons.forEach((button) => {
          positions.add(button.dataset.optionPosition);
        });

        positions.forEach((position) => {
          const activeButton = this.querySelector(
            `.ai-single-product-variant-option-{{ ai_gen_id }}.active[data-option-position="${position}"]`
          );
          if (activeButton) {
            selectedOptions[position - 1] = activeButton.dataset.optionValue;
          }
        });

        const productData = JSON.parse(
          document.querySelector('[data-product-json]')?.textContent || '{}'
        );

        if (productData.variants) {
          const matchingVariant = productData.variants.find((variant) => {
            return variant.options.every((option, index) => option === selectedOptions[index]);
          });

          if (matchingVariant) {
            this.variantInput.value = matchingVariant.id;

            if (this.addToCartButton) {
              if (matchingVariant.available) {
                this.addToCartButton.disabled = false;
                this.addToCartButton.textContent = this.addToCartButton.dataset.originalText || 'In den Warenkorb';
              } else {
                this.addToCartButton.disabled = true;
                this.addToCartButton.textContent = 'Ausverkauft';
              }
            }
          }
        }
      }

      setupQuantityControls() {
        if (!this.quantityInput || !this.quantityButtons) return;

        this.quantityButtons.forEach((button) => {
          button.addEventListener('click', (e) => {
            const action = e.currentTarget.dataset.action;
            let currentValue = parseInt(this.quantityInput.value) || 1;

            if (action === 'increase') {
              currentValue += 1;
            } else if (action === 'decrease' && currentValue > 1) {
              currentValue -= 1;
            }

            this.quantityInput.value = currentValue;
          });
        });

        this.quantityInput.addEventListener('change', (e) => {
          let value = parseInt(e.target.value) || 1;
          if (value < 1) value = 1;
          e.target.value = value;
        });
      }
    }

    customElements.define('single-product-showcase-{{ ai_gen_id }}', SingleProductShowcase{{ ai_gen_id }});
  })();
</script>

{% schema %}
