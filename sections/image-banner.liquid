      "label": "Countdown year",
      "default": "2025"
    },
    {
      "type": "text",
      "id": "product_date",
      "label": "Countdown date",
      "default": "30"
    },
    {
      "type": "text",
      "id": "day_title",
      "label": "Day title",
      "default": "Day"
    },
    {
      "type": "text",
      "id": "hour_title",
      "label": "Hour title",
      "default": "Hour"
    },
    {
      "type": "text",
      "id": "minute_title",
      "label": "Minute title",
      "default": "Min"
    },
    {
      "type": "text",
