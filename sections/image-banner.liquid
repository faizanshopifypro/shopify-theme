{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

{%- if section.settings.image_height == 'adapt' and section.settings.image != blank -%}
  {%- style -%}
    @media screen and (max-width: 749px) {
      #Banner-{{ section.id }}::before,
      #Banner-{{ section.id }} .banner__media::before,
      #Banner-{{ section.id }}:not(.banner--mobile-bottom) .banner__content::before {
        padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }

    @media screen and (min-width: 750px) {
      #Banner-{{ section.id }}::before,
      #Banner-{{ section.id }} .banner__media::before {
        padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
  {%- endstyle -%}
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding-top }}px;
    padding-bottom: {{ section.settings.padding-bottom }}px;
    margin-top: {{ section.settings.margin-top }}px;
    margin-bottom: {{ section.settings.margin-bottom }}px;
  }
  @media screen and (max-width: 1429px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding-top-1429 }}px;
      padding-bottom: {{ section.settings.padding-bottom-1429 }}px;
      margin-top: {{ section.settings.margin-top-1429 }}px;
      margin-bottom: {{ section.settings.margin-bottom-1429 }}px;
    }
  }
  @media screen and (max-width: 1199px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding-top-1199 }}px;
      padding-bottom: {{ section.settings.padding-bottom-1199 }}px;
      margin-top: {{ section.settings.margin-top-1199 }}px;
      margin-bottom: {{ section.settings.margin-bottom-1199 }}px;
    }
  }
  @media screen and (max-width: 991px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding-top-991 }}px;
      padding-bottom: {{ section.settings.padding-bottom-991 }}px;
      margin-top: {{ section.settings.margin-top-991 }}px;
      margin-bottom: {{ section.settings.margin-bottom-991 }}px;
    }
  }
  @media screen and (max-width: 767px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding-top-767 }}px;
      padding-bottom: {{ section.settings.padding-bottom-767 }}px;
      margin-top: {{ section.settings.margin-top-767 }}px;
      margin-bottom: {{ section.settings.margin-bottom-767 }}px;  
    }
  }
  @media screen and (max-width: 575px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding-top-575 }}px;
      padding-bottom: {{ section.settings.padding-bottom-575 }}px;
      margin-top: {{ section.settings.margin-top-575 }}px;
      margin-bottom: {{ section.settings.margin-bottom-575 }}px;  
    }
  }
  #Banner-{{ section.id }}::after {
    opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
  }
  #Banner-{{ section.id }} .banner__box {
    background-color: {{ section.settings.box_background_color }};
  }
  .banner__heading{
    color: {{ section.settings.heading_color }};
  }
  .image_banner_subheading{
    color: {{ section.settings.subheading_color }};
    background: {{ section.settings.subheading_bgcolor }}
  }
  {% if section.settings.subheading_bgcolor == 'rgba(0,0,0,0)' %}
    .image_banner_subheading{ 
      background-color: transparent;
      padding: 0px;
    }
  {% endif %}
  .banner__text.theme_main_description{
    color: {{ section.settings.description_color }};
  }
  .banner__buttons a{
    background-color: {{ section.settings.button_bg }};
    color: {{ section.settings.button_text }};
  }
  .banner__buttons a:hover{
    background-color: {{ section.settings.button_hr_bg }};
    color: {{ section.settings.button_hr_text }};
  }
   .main-image-banner-section .countdown_section{
    color: {{ section.settings.countdown_text }};
    background: {{ section.settings.countdown_bg }}
  }
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'lookbook' -%}
      .lookbook-{{ block.id }}{
        top: {{ block.settings.coordinates_y }}%;
        left: {{ block.settings.coordinates_x }}%;
      }
      .lookbook-{{ block.id }} .custom-product-card .card{
        background-color: {{ block.settings.animation_bg }} !important;
      }
      .lookbook-{{ block.id }}.button_product .button_point{
        background:{{ block.settings.button_bg }};
        color:{{ block.settings.button_text }};
        transition: all .5s ease;
      }
      .lookbook-{{ block.id }}.button_product .button_point:hover{
        background:{{ block.settings.button_hr_bg }};
        color:{{ block.settings.button_hr_text }};
      }
      .lookbook-{{ block.id }}.button_product .button_point:before{
        background-color: {{ block.settings.animation_bg }};
      }
      @media screen and (max-width: 420px) { 
        .lookbook-{{ block.id }}{
          top: {{ block.settings.coordinates_y_420 }}%; 
          left: {{ block.settings.coordinates_x_420 }}%; 
        }
      }
    {% endcase %}
  {% endfor %}
{%- endstyle -%}

{%- liquid
  assign full_width = '100vw'
  assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

<div class="main-image-banner-section section-{{ section.id }}-padding {{ section.settings.section_width }}">
  <div
    id="Banner-{{ section.id }}"
    class="banner banner--content-align-{{ section.settings.desktop_content_alignment }} banner--{{ section.settings.image_height }}{% if section.settings.image != blank %} banner--stacked{% endif %}{% if section.settings.image_height == 'adapt' and section.settings.image != blank %} banner--adapt{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
  >
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'lookbook' -%}
        {%- assign product = all_products[block.settings.product] -%}
        <div class="button_product lookbook-{{ block.id }}">
          <div class="button_point"> + </div>
          <div class="custom-product-card">
            {% if block.settings.product != blank %}
            {% render 'card-product',
              card_product: product,
              media_aspect_ratio: settings.p_image_ratio,
              image_shape: settings.p_image_shape,
              show_secondary_image: settings.p_show_secondary_image,
              show_vendor: settings.p_show_vendor,
              show_badge: settings.show_badge,
              show_countdown: settings.p_show_countdown,
              show_rating: settings.p_show_rating,
              show_quick_add: settings.p_enable_quick_add,
              quantity_enable: settings.p_quantity_enable,
              enable_product_variants: settings.p_variants_enable,
              section_id: section.id
            %}
            {% else %}
            <div class="card">
              <a class="card__inner">
                {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg placeholder' }}
              </a>
              <div class="product-collection__content">
                <h3 class="product-collection__title">
                  <a class="cd">{{ 'onboarding.product_title' | t }}</a>
                </h3>
                <span class="price price--sale">
                  <span class="current"><span class="money">RS.59.00</span></span>
                </span>
              </div>
            </div>
            {% endif %}
          </div>
      
        </div>
        {%- endcase -%}
      {%- endfor -%}
    {%- if section.settings.image != blank -%}
      <div class="banner__media media{% if section.settings.image == blank %} placeholder{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
        {%- liquid
          assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio
        -%}
        {{
          section.settings.image
          | image_url: width: 3840
          | image_tag:
            width: section.settings.image.width,
            height: image_height,
            class: image_class,
            sizes: sizes,
            widths: widths,
            fetchpriority: fetch_priority
        }}
      </div>
    {%- else -%}
      <div class="banner__media media{% if section.settings.image == blank %} placeholder{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
      </div>
    {%- endif -%}
    <div class="banner__content banner__content--{{ section.settings.desktop_content_position }} page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <div class="banner__box content-container content-container--full-width-mobile">
          {% if section.settings.main_subheading != blank %}
            <div class="image_banner_subheading theme_main_subheading">{{ section.settings.main_subheading }}</div>
          {% endif %}
          {% if section.settings.heading != blank %}
            <div class="banner__heading inline-richtext h2 theme_main_heading">{{ section.settings.heading }}</div>
          {% endif %}
          {% if section.settings.text != blank %}
            <div class="banner__text theme_main_description">{{ section.settings.text }}</div>
          {% endif %}
          {% if section.settings.show_countdown %}
            <div class="parallax-countdown">
            <ul class="contdown_row">
              <li class="countdown_section">
                <span id="days" class="countdown_timer"></span>
                <span class="countdown_title">{{ section.settings.day_title }}</span>
              </li>
              <li class="countdown_section">
                <span id="hours" class="countdown_timer"></span>
                <span class="countdown_title">{{ section.settings.hour_title }}</span>
              </li>
              <li class="countdown_section">
                <span id="minutes" class="countdown_timer"></span>
                <span class="countdown_title">{{ section.settings.minute_title }}</span>
              </li>
              <li class="countdown_section">
                <span id="seconds" class="countdown_timer"></span>
                <span class="countdown_title">{{ section.settings.second_title }}</span>
              </li>
            </ul>
          </div>
          <script>
            const second = 1000,
              minute = second * 60,
              hour = minute * 60,
              day = hour * 24;
            let countDown = new Date('{{ section.settings.product_mont }} {{ section.settings.product_date }}, {{ section.settings.product_year }} 00:00:00').getTime(),
              x = setInterval(function () {
                let now = new Date().getTime(),
                  distance = countDown - now;
                document.getElementById('days').innerText = Math.floor(distance / (day)),
                  document.getElementById('hours').innerText = Math.floor((distance % (day)) / (hour)),
                  document.getElementById('minutes').innerText = Math.floor((distance % (hour)) / (minute)),
                  document.getElementById('seconds').innerText = Math.floor((distance % (minute)) / second);
                  if (distance <= 0) {
                    clearInterval(x); // Stop the countdown
                    document.querySelector('.parallax-countdown').style.display = 'none'; // Hide the countdown element
                  }
              }, second)
          </script>
          {% endif %}
          <div class="banner__buttons">
            {%- if section.settings.button_label_1 != blank -%}
              <a
                {% if section.settings.button_link_1 == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ section.settings.button_link_1 }}"
                {% endif %}
                class="button"
                aria-label="{{- section.settings.button_label_1 | escape -}}"
              >
                {{- section.settings.button_label_1 | escape -}}
              </a>
            {%- endif -%}
          </div>
      </div>
    </div>
  </div>
</div>
{% schema %}
