{{ 'parallax-style3.css' | asset_url | stylesheet_tag }}

<div class="image-banner {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
 <div class="image-banner-bg section-{{ section.id }}-padding">
   <div class="image-banner-content">
     <div class="{{ section.settings.section_width }}">
       <div class="banner-main-content">
         <div class="banner-left-text">
             <div class="theme_main_subheading">{{ section.settings.main_subheading }}</div>
              <h2 class="theme_main_heading">{{ section.settings.main_heading }}</h2>
              <div class="image-content-text">
                {% for block in section.blocks %}
                    {% if block.type == 'banner-content' %}
                      <div class="image-banner-icon-content">
                          <div class="banner-content-icon">
                            {{ block.settings.box-block-icon }}
                          </div>
                          <div class="banner-box-content">
                            <div class="banner-content-title">{{ block.settings.box-title }}</div>
                          </div>
                        </div>
                    {% endif %} 
                  {% endfor %}
              </div>
         </div>
         <div class="banner-right-text">
           <p class="theme_main_description">{{ section.settings.main_paragraph }}</p>
             <div class="image-banner-countdown">
              <ul class="contdown_row">
                <li class="countdown_section">
                  <span id="days" class="countdown_timer"></span>
                  <span class="countdown_title">{{ section.settings.day_title }}</span>
                </li>
                <li class="countdown_section">
                  <span id="hours" class="countdown_timer"></span>
                  <span class="countdown_title">{{ section.settings.hour_title }}</span>
                </li>
                <li class="countdown_section">
                  <span id="minutes" class="countdown_timer"></span>
                  <span class="countdown_title">{{ section.settings.minute_title }}</span>
                </li>
                <li class="countdown_section">
                  <span id="seconds" class="countdown_timer"></span>
                  <span class="countdown_title">{{ section.settings.second_title }}</span>
                </li>
              </ul>
            </div>
            <script>
              const second = 1000,
                minute = second * 60,
                hour = minute * 60,
                day = hour * 24;
                let countDown = new Date('{{ section.settings.product_mont }} {{ section.settings.product_date }}, {{ section.settings.product_year }} 00:00:00').getTime(),
                  x = setInterval(function () {
                    let now = new Date().getTime(),
                      distance = countDown - now;
                    document.getElementById('days').innerText = Math.floor(distance / (day)),
                      document.getElementById('hours').innerText = Math.floor((distance % (day)) / (hour)),
                      document.getElementById('minutes').innerText = Math.floor((distance % (hour)) / (minute)),
                      document.getElementById('seconds').innerText = Math.floor((distance % (minute)) / second);
                  }, second)
            </script>

           <a {% if section.settings.banner-url %} href="{{ section.settings.banner-url }}" {% else %}
                role="link" aria-disabled="true" {% endif %} class="button theme_buttons wow fadeInUp">{{
                section.settings.banner-btn-text }}</a>
         </div>
     </div>
   </div>
 </div>
   <div class="banner-second-img">
    {% if section.settings.banner_img != blank %}
      <div class="media media--transparent ratio" style="--ratio-percent: 88%">
        {{ section.settings.banner_img | image_url: width: 1920 | image_tag : loading: 'lazy', class: 'w-100' }}
      </div>
      {% else %}
      <div class="media media--transparent ratio" style="--ratio-percent: 88%">
        {{ 'image' | placeholder_svg_tag: 'placeholder placeholder-svg' }}
      </div>
      {% endif %}    
    </div>
</div>

{%- style -%}
  {% if section.settings.pattern-style -%}
  .image-banner:after{
    background: {{ section.settings.pattrn_background_color }};
    -webkit-mask-image: url({% if section.settings.section_pattern != blank %} {{ section.settings.section_pattern | img_url: 'master' }} {% endif %});
  }
  {% endif %}
  {% if section.settings.pattern-style == false  -%}
   .image-banner:after{
    content: none;
  }
  {% endif %}
  .image-banner-content .theme_buttons:hover {
    color:{{ section.settings.theme_btn_hr_text }};
    background:{{ section.settings.theme_btn_hr_bg }}; 
  }
  .image-banner-content .theme_buttons {
    background: {{ section.settings.theme_btn_bg }}; 
    color:{{ section.settings.theme_btn_text }}; 
  }
  .image-banner-content .countdown_section{
    background: {{ section.settings.count_bg }};
    color: {{ section.settings.count_text }};
  }
  .image-banner-content .banner-content-title{
    color: {{ section.settings.content_color }};
  }
  .image-banner-content .banner-content-icon svg path{
    stroke: {{ section.settings.content_color }};
    fill: {{ section.settings.content_color }} !important;
  }
  .image-banner-content .theme_main_heading {
    color: {{ section.settings.theme_heading_color }};
  }
  .image-banner-content .theme_main_subheading {
    background: {{ section.settings.theme_subheading_bgcolor }};
    color: {{ section.settings.theme_subheading_color }};
  }
  {% if section.settings.theme_subheading_bgcolor == 'rgba(0,0,0,0)' %}
    .image-banner-content .theme_main_subheading { 
      background-color: transparent;
      padding: 0px;
    }
  {% endif %}
  .image-banner-content .theme_main_description{
    color: {{ section.settings.description_color }};
  }
  .section-{{ section.id }}-padding {
    background-color: {{ section.settings.section_bg }};
    padding-top: {{ section.settings.padding-top }}px;
    padding-bottom: {{ section.settings.padding-bottom }}px;
    margin-top: {{ section.settings.margin-top }}px;
    margin-bottom: {{ section.settings.margin-bottom }}px;
    background-image: url({% if section.settings.bg_pattern != blank %} {{ section.settings.bg_pattern | img_url: 'master' }} {% endif %});
  }
  @media screen and (max-width: 1429px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding-top-1429 }}px;
      padding-bottom: {{ section.settings.padding-bottom-1429 }}px;
      margin-top: {{ section.settings.margin-top-1429 }}px;
      margin-bottom: {{ section.settings.margin-bottom-1429 }}px;
    }
  }
  @media screen and (max-width: 1199px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding-top-1199 }}px;
      padding-bottom: {{ section.settings.padding-bottom-1199 }}px;
      margin-top: {{ section.settings.margin-top-1199 }}px;
      margin-bottom: {{ section.settings.margin-bottom-1199 }}px;
    }
  }
  @media screen and (max-width: 991px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding-top-991 }}px;
      padding-bottom: {{ section.settings.padding-bottom-991 }}px;
      margin-top: {{ section.settings.margin-top-991 }}px;
      margin-bottom: {{ section.settings.margin-bottom-991 }}px;
    }
  }
  @media screen and (max-width: 767px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding-top-767 }}px;
      padding-bottom: {{ section.settings.padding-bottom-767 }}px;
      margin-top: {{ section.settings.margin-top-767 }}px;
      margin-bottom: {{ section.settings.margin-bottom-767 }}px;  
    }
  }
  @media screen and (max-width: 575px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding-top-575 }}px;
      padding-bottom: {{ section.settings.padding-bottom-575 }}px;
      margin-top: {{ section.settings.margin-top-575 }}px;
      margin-bottom: {{ section.settings.margin-bottom-575 }}px;  
    }
  }
{%- endstyle -%}

