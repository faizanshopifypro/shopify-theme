<section class="cr-wrap" id="cr-{{ section.id }}">
  <div class="cr-inner page-width">
    <h2 class="cr-title">{{ section.settings.heading | escape }}</h2>

    <div class="cr-rating cr-clickable" data-cr-link>
      <div class="cr-rating-number">
        {{ section.settings.rating }}<span class="cr-rating-outof">/5</span>
        <span class="cr-rating-label">{{ section.settings.rating_label }}</span>
      </div>

      <div class="cr-stars cr-clickable" data-cr-link>
        {% for i in (1..5) %}
          <span class="cr-star">
            <svg viewBox="0 0 24 24"><path d="M12 2.2l2.9 6.2 6.8.6-5.1 4.4 1.6 6.6L12 16.9 5.8 20l1.6-6.6L2.3 9l6.8-.6L12 2.2z"/></svg>
          </span>
        {% endfor %}
      </div>

      <div class="cr-count cr-clickable" data-cr-link>
        {{ section.settings.count_prefix }}
        <span class="cr-count-number">{{ section.settings.total_reviews }}</span>
        {{ section.settings.count_suffix }}
      </div>
    </div>

    {% if section.settings.show_trust_badges %}
      <div class="cr-badges" aria-label="Trust badges">
        {% if section.settings.badge_1_show and section.settings.badge_1_text != blank %}
          <div class="cr-badge">
            {% if section.settings.badge_1_icon %}
              <span class="cr-badge-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg>
              </span>
            {% endif %}
            <span class="cr-badge-text">{{ section.settings.badge_1_text }}</span>
          </div>
        {% endif %}

        {% if section.settings.badge_2_show and section.settings.badge_2_text != blank %}
          <div class="cr-badge">
            {% if section.settings.badge_2_icon %}
              <span class="cr-badge-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg>
              </span>
            {% endif %}
            <span class="cr-badge-text">{{ section.settings.badge_2_text }}</span>
          </div>
        {% endif %}

        {% if section.settings.badge_3_show and section.settings.badge_3_text != blank %}
          <div class="cr-badge">
            {% if section.settings.badge_3_icon %}
              <span class="cr-badge-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg>
              </span>
            {% endif %}
            <span class="cr-badge-text">{{ section.settings.badge_3_text }}</span>
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="cr-slider">
      <button class="cr-nav cr-prev" type="button" data-cr-prev aria-label="Previous">‹</button>

      <div class="cr-slides">
        {% for block in section.blocks %}
          <article class="cr-slide {% if forloop.first %}is-active{% endif %}" data-cr-slide {{ block.shopify_attributes }}>
            <div class="cr-slide-stars cr-clickable" data-cr-link>
              {% for i in (1..5) %}
                <span class="cr-star">
                  <svg viewBox="0 0 24 24"><path d="M12 2.2l2.9 6.2 6.8.6-5.1 4.4 1.6 6.6L12 16.9 5.8 20l1.6-6.6L2.3 9l6.8-.6L12 2.2z"/></svg>
                </span>
              {% endfor %}
            </div>

            {% if block.settings.headline != blank %}
              <h3 class="cr-slide-head cr-clickable" data-cr-link>{{ block.settings.headline }}</h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <p class="cr-slide-text cr-clickable" data-cr-link>{{ block.settings.text }}</p>
            {% endif %}

            {% if block.settings.author != blank %}
              <div class="cr-slide-author cr-clickable" data-cr-link>{{ block.settings.author }}</div>
            {% endif %}
          </article>
        {% endfor %}
      </div>

      <button class="cr-nav cr-next" type="button" data-cr-next aria-label="Next">›</button>
    </div>

    {% if section.settings.show_button and section.settings.button_label != blank %}
      <div class="cr-button-wrap">
        <a href="{{ section.settings.button_link }}" class="cr-button">
          {{ section.settings.button_label }}
        </a>
      </div>
    {% endif %}
  </div>

  <style>
    #cr-{{ section.id }}{
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      background:#fff;
      text-align:center;
    }

    {% if section.settings.enable_click_link and section.settings.click_link != blank %}
      #cr-{{ section.id }}{ cursor:pointer; }
      #cr-{{ section.id }} .cr-clickable{ cursor:pointer; }
    {% endif %}

    .cr-title{
      font-weight:800;
      letter-spacing:.05em;
      text-transform:uppercase;
      font-size: clamp(22px, 2.2vw, 34px);
      margin-bottom:20px;
    }

    .cr-rating-number{ font-weight:800;font-size:22px; }
    .cr-rating-label{ margin-left:6px;font-weight:700; }
    .cr-count{ font-size:13px;opacity:.7; }

    .cr-stars,.cr-slide-stars{
      display:flex;justify-content:center;gap:4px;margin:6px 0;
    }
    .cr-star{ width:18px;height:18px; }
    .cr-star svg{ width:100%;height:100%;fill:#111; }

    .cr-badges{
      margin: 10px auto 0;
      display:flex;
      gap:10px;
      justify-content:center;
      flex-wrap:wrap;
      max-width: 820px;
    }
    .cr-badge{
      display:flex;
      align-items:center;
      gap:8px;
      font-size: 13px;
      opacity:.85;
      padding: 6px 10px;
      border: 1px solid rgba(0,0,0,.08);
      border-radius: 999px;
      background: rgba(0,0,0,.02);
    }
    .cr-badge-icon{ width:16px;height:16px;display:inline-block; }
    .cr-badge-icon svg{ width:100%;height:100%;fill:#111;opacity:.85; }

    .cr-slider{ display:flex;align-items:center;justify-content:center; gap:10px;margin-top:20px; }
    .cr-slides{ max-width:760px;min-height:170px; display:grid;place-items:center;padding:0 30px; }
    .cr-slide{ display:none; }
    .cr-slide.is-active{ display:block; animation:fade .25s ease; }
    @keyframes fade{ from{opacity:0} to{opacity:1} }

    .cr-slide-head{ font-weight:800;margin:10px 0; }
    .cr-slide-text{ font-size:14px;line-height:1.6;opacity:.9; }
    .cr-slide-author{ font-size:13px;opacity:.6;margin-top:8px; }

    .cr-nav{
      width:42px;height:42px;border-radius:50%;
      border:1px solid rgba(0,0,0,.1);
      background:transparent;font-size:26px;
      cursor:pointer;opacity:.6;
    }
    .cr-nav:hover{ opacity:1; }

    .cr-button-wrap{ margin-top:30px; }
    .cr-button{
      display:inline-block;
      background: {{ section.settings.button_bg }};
      color: {{ section.settings.button_text }};
      border: 1px solid {{ section.settings.button_border }};
      border-radius: {{ section.settings.button_radius }}px;
      padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;
      font-size: {{ section.settings.button_font_size }}px;
      text-decoration:none;
      font-weight:600;
      transition:.2s ease;
    }
    .cr-button:hover{ opacity:.85; transform:translateY(-1px); }

    @media (max-width: 640px){
      #cr-{{ section.id }} .cr-star{ width:20px;height:20px; }
      #cr-{{ section.id }} .cr-rating{ margin-bottom:10px; }
      #cr-{{ section.id }} .cr-slide-head{ margin-top:6px; }
      #cr-{{ section.id }} .cr-slide-text{ font-size:15px;line-height:1.65; }
      #cr-{{ section.id }} .cr-nav{ width:48px;height:48px; }
      #cr-{{ section.id }} .cr-button{ width:100%;text-align:center; }
      #cr-{{ section.id }} .cr-title{ letter-spacing:.03em; }
      #cr-{{ section.id }} .cr-badge{ font-size: 12.5px; padding: 6px 10px; }
    }
  </style>

  <script>
    (function(){
      const root=document.getElementById("cr-{{ section.id }}");
      if(!root) return;

      const slides=root.querySelectorAll("[data-cr-slide]");
      if(slides.length>=2){
        let i=0;
        const show=n=>{
          slides[i].classList.remove("is-active");
          i=(n+slides.length)%slides.length;
          slides[i].classList.add("is-active");
        };

        const prev=root.querySelector("[data-cr-prev]");
        const next=root.querySelector("[data-cr-next]");
        if(prev) prev.addEventListener("click",(e)=>{e.stopPropagation();show(i-1);});
        if(next) next.addEventListener("click",(e)=>{e.stopPropagation();show(i+1);});

        // AUTOSLIDER
        const autoplayEnabled={{ section.settings.autoplay | json }};
        const autoplayMs=Number({{ section.settings.autoplay_speed | json }})||4000;
        let timer=null;

        const start=()=>{
          if(!autoplayEnabled) return;
          stop();
          timer=setInterval(()=>show(i+1),autoplayMs);
        };
        const stop=()=>{ if(timer){clearInterval(timer);timer=null;} };

        start();
        root.addEventListener("mouseenter",stop);
        root.addEventListener("mouseleave",start);
        root.addEventListener("touchstart",stop,{passive:true});
        root.addEventListener("touchend",start,{passive:true});
      }

      const enabled={{ section.settings.enable_click_link | json }};
      const link={{ section.settings.click_link | json }};
      if(enabled && link){
        root.addEventListener("click",function(e){
          if(e.target.closest("a")||e.target.closest("[data-cr-prev]")||e.target.closest("[data-cr-next]")) return;
          window.location.href=link;
        });
      }
    })();
  </script>
</section>

{% schema %}
{
  "name": "Customer reviews (manual)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "DAS SAGEN UNSERE KUNDEN" },

    { "type": "text", "id": "rating", "label": "Rating", "default": "4.84" },
    { "type": "text", "id": "rating_label", "label": "Rating label", "default": "Sterne" },
    { "type": "text", "id": "count_prefix", "label": "Count prefix", "default": "von" },
    { "type": "number", "id": "total_reviews", "label": "Total reviews", "default": 145 },
    { "type": "text", "id": "count_suffix", "label": "Count suffix", "default": "Bewertungen" },

    { "type": "range", "id": "padding_top", "label": "Spacing top", "min": 0, "max": 150, "step": 5, "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Spacing bottom", "min": 0, "max": 150, "step": 5, "default": 60 },

    { "type": "checkbox", "id": "show_trust_badges", "label": "Show trust badges", "default": true },

    { "type": "checkbox", "id": "badge_1_show", "label": "Badge 1: show", "default": true },
    { "type": "checkbox", "id": "badge_1_icon", "label": "Badge 1: show check icon", "default": true },
    { "type": "text", "id": "badge_1_text", "label": "Badge 1 text", "default": "Verifizierter Verkäufer" },

    { "type": "checkbox", "id": "badge_2_show", "label": "Badge 2: show", "default": true },
    { "type": "checkbox", "id": "badge_2_icon", "label": "Badge 2: show check icon", "default": true },
    { "type": "text", "id": "badge_2_text", "label": "Badge 2 text", "default": "Schneller Versand" },

    { "type": "checkbox", "id": "badge_3_show", "label": "Badge 3: show", "default": true },
    { "type": "checkbox", "id": "badge_3_icon", "label": "Badge 3: show check icon", "default": true },
    { "type": "text", "id": "badge_3_text", "label": "Badge 3 text", "default": "30 Tage Rückgabe" },

    { "type": "checkbox", "id": "show_button", "label": "Show button", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Mehr anzeigen" },
    { "type": "url", "id": "button_link", "label": "Button link" },

    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#111111" },
    { "type": "color", "id": "button_text", "label": "Button text color", "default": "#ffffff" },
    { "type": "color", "id": "button_border", "label": "Button border color", "default": "#111111" },

    { "type": "range", "id": "button_radius", "label": "Button border radius", "min": 0, "max": 50, "step": 2, "default": 30 },
    { "type": "range", "id": "button_padding_x", "label": "Button horizontal padding", "min": 10, "max": 60, "step": 2, "default": 26 },
    { "type": "range", "id": "button_padding_y", "label": "Button vertical padding", "min": 6, "max": 30, "step": 2, "default": 12 },
    { "type": "range", "id": "button_font_size", "label": "Button font size", "min": 12, "max": 24, "step": 1, "default": 16 },

    { "type": "checkbox", "id": "enable_click_link", "label": "Make section clickable", "default": false },
    { "type": "url", "id": "click_link", "label": "Click link" },

    { "type": "checkbox", "id": "autoplay", "label": "Autoplay (Autoslider)", "default": true },
    { "type": "range", "id": "autoplay_speed", "label": "Autoplay speed (ms)", "min": 2000, "max": 9000, "step": 500, "default": 4000 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "headline", "label": "Headline", "default": "Klasse Qualität" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Das Armband sitzt perfekt und ist Größenverstellbar." },
        { "type": "text", "id": "author", "label": "Author", "default": "Tom G." }
      ]
    }
  ],
  "presets": [
    { "name": "Customer reviews (manual)" }
  ]
}
{% endschema %}



