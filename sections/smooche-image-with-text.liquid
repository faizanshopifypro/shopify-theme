{{ 'smooche-phase5.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign reverse = section.settings.reverse
  assign usp_icon_1 = section.settings.usp_1_icon_asset | default: 'smooche-usp-adapts.svg'
  assign usp_icon_2 = section.settings.usp_2_icon_asset | default: 'smooche-usp-hides.svg'
-%}

<section class="smooche-iwt section-{{ section.id }}">
  <div class="smooche-iwt__inner">
    <div class="smooche-iwt__grid{% if reverse %} smooche-iwt__grid--reverse{% endif %}">
      <div class="smooche-iwt__image">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              widths: '400,700,1000,1200',
              sizes: '(min-width: 750px) 45vw, 100vw',
              alt: section.settings.heading
          }}
        {%- elsif section.settings.fallback_asset != blank -%}
          <img
            src="{{ section.settings.fallback_asset | asset_url }}"
            alt="{{ section.settings.heading | escape }}"
            width="1200"
            height="1200"
            loading="lazy"
          >
        {%- endif -%}
      </div>

      <div class="smooche-iwt__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="smooche-iwt__heading">
            {{ section.settings.heading }}
            {%- if section.settings.heading_highlight != blank -%}
              <span class="smooche-iwt__highlight">{{ section.settings.heading_highlight }}</span>
            {%- endif -%}
          </h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="smooche-iwt__text">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.usp_1 != blank or section.settings.usp_2 != blank -%}
          <div class="smooche-iwt__usps">
            {%- if section.settings.usp_1 != blank -%}
              <div class="smooche-iwt__usp">
                <img src="{{ usp_icon_1 | asset_url }}" alt="" width="32" height="32" loading="lazy">
                <div class="smooche-iwt__usp-text"><p>{{ section.settings.usp_1 }}</p></div>
              </div>
            {%- endif -%}
            {%- if section.settings.usp_2 != blank -%}
              <div class="smooche-iwt__usp">
                <img src="{{ usp_icon_2 | asset_url }}" alt="" width="32" height="32" loading="lazy">
                <div class="smooche-iwt__usp-text"><p>{{ section.settings.usp_2 }}</p></div>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Smooche image with text",
  "tag": "section",
  "class": "section-smooche-iwt",
  "settings": [
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Image on right",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "fallback_asset",
      "label": "Fallback theme asset filename",
      "info": "e.g. smooche-adapts-img.png"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Foundation that"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Heading highlight",
      "default": "adapts to you"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Meet the foundation that takes the guesswork out of beauty.</p>"
    },
    {
      "type": "text",
      "id": "usp_1",
      "label": "USP 1",
      "default": "Adapts to your skin tone"
    },
    {
      "type": "text",
      "id": "usp_1_icon_asset",
      "label": "USP 1 icon asset",
      "default": "smooche-usp-adapts.svg"
    },
    {
      "type": "text",
      "id": "usp_2",
      "label": "USP 2",
      "default": "Hides imperfections"
    },
    {
      "type": "text",
      "id": "usp_2_icon_asset",
      "label": "USP 2 icon asset",
      "default": "smooche-usp-hides.svg"
    }
  ],
  "presets": [{ "name": "Smooche image with text" }]
}
{% endschema %}
