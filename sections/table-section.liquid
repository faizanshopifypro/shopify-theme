<div class="dynemic-tabele-wrapper section-{{ section.id }}-padding">
  <div class="{{ section.settings.section_width }}">
    <div class="dynamic-table-wrapper">
      <table class="dynamic-table">
        {% assign headers_block = section.blocks | where: 'type', 'header' | first %}
        {% if headers_block %}
          <thead>
            <tr>
              {% assign header_titles = headers_block.settings.headers | split: ',' %}
              {% for header in header_titles %}
                <th>{{ header | strip }}</th>
              {% endfor %}
            </tr>
          </thead>
        {% endif %}
    
        <tbody>
          {% for block in section.blocks %}
            {% if block.type == 'row' %}
              <tr>
                {% assign row_items = block.settings.row_data | split: ',' %}
                {% for item in row_items %}
                  <td>{{ item | strip }}</td>
                {% endfor %}
              </tr>
            {% endif %}
            {% if block.type == 'image_row' %}
              <tr>
                {% assign image_urls = block.settings.image_urls | split: ',' %}
                {% for image in image_urls %}
                  <td>
                    <img src="{{ image | strip }}" alt="Table Image" style="max-width: {{ block.settings.image_max_width }}px; height: auto;" loading="lazy" />
                  </td>
                {% endfor %}
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
  <style>
  .dynamic-table-wrapper {
    overflow-x: auto;
  }

  .dynamic-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 600px;
  }

  .dynamic-table th,
  .dynamic-table td {
    text-align: {{ section.settings.text_alignment }};
    padding: 12px;
    white-space: nowrap;
    line-height: 1;
  }

  {% assign headers_block = section.blocks | where: 'type', 'header' | first %}
  {% if headers_block %}
    .dynamic-table th {
      border: 1px solid {{ headers_block.settings.heding_border }};
      background-color: {{ headers_block.settings.heding_bg }};
      color: {{ headers_block.settings.heding_text }};
      font-weight: bold;
      text-align: {{ section.settings.text_alignment }};
      font-size: 16px;
    }
  {% endif %}

  {% for block in section.blocks %}
    {% if block.type == 'row' %}
      .dynamic-table td {
        border: 1px solid {{ block.settings.content_border }};
        background-color: {{ block.settings.content_bg }};
        color: {{ block.settings.content_text }};
        font-size: 14px;
      }

      .dynamic-table td a {
        color: {{ block.settings.content_link }};
        text-decoration: underline !important;
      }
    {% endif %}
  {% endfor %}

  {% if section.settings.section_bg != "rgba(0,0,0,0)" %}
  .dynemic-tabele-wrapper{
      background-color: {{ section.settings.section_bg }};
    }
  {% endif %}
    
  {% if section.settings.bg_img != blank %}
    .dynemic-tabele-wrapper{
      background-image: url({% if section.settings.bg_img != blank %} {{ section.settings.bg_img | image_url: width: 1920 }} {% endif %}) !important;
      background-position: center !important;
      background-repeat: no-repeat !important;
      background-size: cover !important;
      background-attachment: {{ section.settings.image_behaviour }};
    }
  {% endif %}
  
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding-top }}px;
    padding-bottom: {{ section.settings.padding-bottom }}px;
    margin-top: {{ section.settings.margin-top }}px;
    margin-bottom: {{ section.settings.margin-bottom }}px;
    
  }
  @media screen and (max-width: 1429px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding-top-1429 }}px;
      padding-bottom: {{ section.settings.padding-bottom-1429 }}px;
      margin-top: {{ section.settings.margin-top-1429 }}px;
      margin-bottom: {{ section.settings.margin-bottom-1429 }}px;
    }
  }
  @media screen and (max-width: 1199px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding-top-1199 }}px;
      padding-bottom: {{ section.settings.padding-bottom-1199 }}px;
      margin-top: {{ section.settings.margin-top-1199 }}px;
      margin-bottom: {{ section.settings.margin-bottom-1199 }}px;
    }
  }
  @media screen and (max-width: 991px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding-top-991 }}px;
      padding-bottom: {{ section.settings.padding-bottom-991 }}px;
      margin-top: {{ section.settings.margin-top-991 }}px;
      margin-bottom: {{ section.settings.margin-bottom-991 }}px;
    }
    .banner1-{{ section.id }} .four-image-with-text-banner-section-wrapper{
      row-gap: {{ settings.spacing_grid_vertical | divided_by: 2 }}px;
      margin: 0px -{{ settings.spacing_grid_horizontal | divided_by: 4 }}px;
    }
    .banner1-{{ section.id }} .four-first-banner-section.col-lg-6,
    .banner1-{{ section.id }} .four-first-banner-section.col-lg-3{
       padding: 0px {{ settings.spacing_grid_horizontal | divided_by: 4 }}px;
    }
  }
  @media screen and (max-width: 767px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding-top-767 }}px;
      padding-bottom: {{ section.settings.padding-bottom-767 }}px;
      margin-top: {{ section.settings.margin-top-767 }}px;
      margin-bottom: {{ section.settings.margin-bottom-767 }}px;  
    }
  }
  @media screen and (max-width: 575px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding-top-575 }}px;
      padding-bottom: {{ section.settings.padding-bottom-575 }}px;
      margin-top: {{ section.settings.margin-top-575 }}px;
      margin-bottom: {{ section.settings.margin-bottom-575 }}px;  
    }
  }
</style>

