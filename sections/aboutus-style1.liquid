{{ 'aboutus-style1.css' | asset_url | stylesheet_tag }}
<div class="section-{{ section.id }}-padding {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
  <div class="about_style1">
      <div class="{{ section.settings.section_width }}">
        <div class="abut-main-row">
          <div class="about-second-part">
            <div class="first-part-img">
               <div class="about-hover-img">
                  {% if section.settings.about_us_img != blank %}
                  <div class="media media--transparent ratio" style="--ratio-percent: 97%">
                    {{ section.settings.about_us_img | image_url: width: 1920 | image_tag : loading: 'lazy', class: 'magniflier w-100' }}
                  </div>
                  {% else %}
                  <div class="media media--transparent ratio" style="--ratio-percent: 97%">
                    {{ 'collection-6' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                  </div>
                  {% endif %}
               </div>
  
            </div>
          </div>
          
          <div class="about-first-part">
            <div class="about2_title {{ section.settings.main_title_alignment }}">
              {% if section.settings.heading-img != blank or section.settings.subheading != blank or section.settings.title != blank or section.settings.description != blank %}
                <div class="title_bottom_margin">
                  {% if section.settings.heading-img != blank %}
                    <div class="heading-img w-100 {{ section.settings.main_title_alignment }}">
                      <img src="{{ section.settings.heading-img | img_url: 'master' }}" alt="slider-img" class="w-100" loading="eager">
                    </div>
                  {% endif %}
                  {% if section.settings.subheading != blank %}
                    <div class="theme_main_subheading">{{ section.settings.subheading }}</div>
                  {% endif %}
                  {% if section.settings.title != blank %}
                    <div class="theme_main_heading h2">{{ section.settings.title }}</div>
                  {% endif %}
                  {% if section.settings.description != blank %}
                    <p class="theme_main_description">{{ section.settings.description }}</p>
                  {% endif %}
                </div>
              {% endif %}

              <div class="about-us-block-title">
                {% for block in section.blocks %}
                  {% if block.type == 'about-content' %}
                    <div class="about-us-title">
                      <div class="icon-box">
                        <div class="about-content-icon">
                          {{ block.settings.box-block-icon }}
                        </div>
                        <div class="icon-box-content">
                          <div class="about-content-title">{{ block.settings.box-title }}</div>
                        </div>
                      </div>
                    </div>
                  {% endif %} 
                {% endfor %}
              </div>
              
              <a {% if section.settings.about-btn-url %} href="{{ section.settings.about-btn-url }}" {% else %}
                role="link" aria-disabled="true" {% endif %} class="button theme_buttons">{{
                section.settings.about-btn-text }}</a>
            </div>
          </div>
        </div>
      </div>
  </div>
</div>

{% style %}
  .about_style1 .heading-img.center{
    margin: 0 auto;
  }
  .about_style1 .heading-img.right{
    margin: 0 0 0 auto;
  }
  .about_style1 .first-part-img:before {
    background-image: url({% if section.settings.back-img != blank %} {{ section.settings.back-img | img_url: 'master' }} {% endif %});
  }
  .about_style1 .about-content-icon svg path{
    stroke: {{ section.settings.title-color }};
    fill: {{ section.settings.title-color }} !important;
  }
  .about_style1 .about-content-title{
    color: {{ section.settings.title-color }};
  }
  .about_style1 .theme_main_heading {
    color: {{ section.settings.theme_heading_color }};
  }
  .about_style1 .theme_main_subheading {
    color: {{ section.settings.theme_subheading_color }};
    background: {{ section.settings.theme_subheading_bgcolor }};
  }
  {% if section.settings.theme_subheading_bgcolor == 'rgba(0,0,0,0)' %}
    .about_style1 .theme_main_subheading { 
      background-color: transparent;
      padding: 0px;
    }
  {% endif %}
  .about_style1 .theme_main_description{
    color: {{ section.settings.content_color }};
  }
  .about_style1 .theme_buttons {
    background: {{ section.settings.theme_btn_bg }};
    color: {{ section.settings.theme_btn_text }};
  }
  .about_style1 .theme_buttons:hover {
    color:{{ section.settings.theme_btn_hr_text }};
    background: {{ section.settings.theme_btn_hr_bg }};
  }
  .about_style1 .about2_title.left{
    text-align: left;
  }
  .about_style1 .about2_title.center{
    text-align: center;
  }
  .about_style1 .about2_title.right{
    text-align: right;
  }
  .about_style1 .about2_title.left .icon-box {
    justify-content: left;
  }
  .about_style1 .about2_title.center .icon-box {
    justify-content: center;
  }
  .about_style1 .about2_title.right .icon-box {
    justify-content: right;
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding-top }}px;
    padding-bottom: {{ section.settings.padding-bottom }}px;
    margin-top: {{ section.settings.margin-top }}px;
    margin-bottom: {{ section.settings.margin-bottom }}px;
    background-color: {{ section.settings.section_bg }};
  }
  @media screen and (max-width: 1429px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding-top-1429 }}px;
      padding-bottom: {{ section.settings.padding-bottom-1429 }}px;
      margin-top: {{ section.settings.margin-top-1429 }}px;
      margin-bottom: {{ section.settings.margin-bottom-1429 }}px;
    }
  }
  @media screen and (max-width: 1199px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding-top-1199 }}px;
      padding-bottom: {{ section.settings.padding-bottom-1199 }}px;
      margin-top: {{ section.settings.margin-top-1199 }}px;
      margin-bottom: {{ section.settings.margin-bottom-1199 }}px;
    }
  }
  @media screen and (max-width: 991px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding-top-991 }}px;
      padding-bottom: {{ section.settings.padding-bottom-991 }}px;
      margin-top: {{ section.settings.margin-top-991 }}px;
      margin-bottom: {{ section.settings.margin-bottom-991 }}px;
    }
  }
  @media screen and (max-width: 767px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding-top-767 }}px;
      padding-bottom: {{ section.settings.padding-bottom-767 }}px;
      margin-top: {{ section.settings.margin-top-767 }}px;
      margin-bottom: {{ section.settings.margin-bottom-767 }}px;  
    }
  }
  @media screen and (max-width: 575px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding-top-575 }}px;
      padding-bottom: {{ section.settings.padding-bottom-575 }}px;
      margin-top: {{ section.settings.margin-top-575 }}px;
      margin-bottom: {{ section.settings.margin-bottom-575 }}px;  
    }
  }
{% endstyle %}

