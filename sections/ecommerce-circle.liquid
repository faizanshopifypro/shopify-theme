{% comment %}
  Ecommerce Circular Diagram Section
  Developer: Custom Shopify Section
{% endcomment %}

<section class="ecom-circle-wrapper">
  <div class="ecom-circle-container">

    <!-- Center Circle -->
    <div class="ecom-center">
      <div class="ecom-center-inner">
        <div class="ecom-center-icon">
          {% if section.settings.center_icon != blank %}
            <img src="{{ section.settings.center_icon | image_url }}" alt="center icon">
          {% endif %}
        </div>
        <h3>{{ section.settings.center_title }}</h3>
      </div>
    </div>

    <!-- Blocks -->
    {% for block in section.blocks %}
      <div class="ecom-node ecom-node-{{ forloop.index }}">
        <div class="ecom-node-line"></div>

        <div class="ecom-node-box">
          <div class="ecom-node-icon">
            {% if block.settings.icon != blank %}
              <img src="{{ block.settings.icon | image_url }}" alt="{{ block.settings.title }}">
            {% endif %}
          </div>
          <div class="ecom-node-text">
            {{ block.settings.title }}
          </div>
        </div>
      </div>
    {% endfor %}

  </div>
</section>

<style>
  .ecom-circle-wrapper {
    padding-top: {{ section.settings.padding-top }}px;
    padding-bottom: {{ section.settings.padding-bottom }}px;
    margin-top: {{ section.settings.margin-top }}px;
    margin-bottom: {{ section.settings.margin-bottom }}px;
    background-color: {{ section.settings.bg_color }};
  }
  @media screen and (max-width: 1429px) {
    .ecom-circle-wrapper {
      padding-top: {{ section.settings.padding-top-1429 }}px;
      padding-bottom: {{ section.settings.padding-bottom-1429 }}px;
      margin-top: {{ section.settings.margin-top-1429 }}px;
      margin-bottom: {{ section.settings.margin-bottom-1429 }}px;
    }
  }
  @media screen and (max-width: 1199px) {
    .ecom-circle-wrapper {
      padding-top: {{ section.settings.padding-top-1199 }}px;
      padding-bottom: {{ section.settings.padding-bottom-1199 }}px;
      margin-top: {{ section.settings.margin-top-1199 }}px;
      margin-bottom: {{ section.settings.margin-bottom-1199 }}px;
    }
  }
  @media screen and (max-width: 991px) {
    .ecom-circle-wrapper {
      padding-top: {{ section.settings.padding-top-991 }}px;
      padding-bottom: {{ section.settings.padding-bottom-991 }}px;
      margin-top: {{ section.settings.margin-top-991 }}px;
      margin-bottom: {{ section.settings.margin-bottom-991 }}px;
    }
    .main-instagram-post-section .instagram-main-wrapper{
      row-gap: {{ settings.spacing_grid_vertical | divided_by: 2 }}px;
      margin: 0px -{{ settings.spacing_grid_horizontal | divided_by: 4 }}px;
    }
    .main-instagram-post-section .desktop--1-column .instagram-image-item,
    .main-instagram-post-section .desktop--2-column .instagram-image-item,
    .main-instagram-post-section .desktop--3-column .instagram-image-item,
    .main-instagram-post-section .desktop--4-column .instagram-image-item,
    .main-instagram-post-section .desktop--5-column .instagram-image-item{
       padding: 0px {{ settings.spacing_grid_horizontal | divided_by: 4 }}px;
    }
  }
  @media screen and (max-width: 767px) {
    .ecom-circle-wrapper {
      padding-top: {{ section.settings.padding-top-767 }}px;
      padding-bottom: {{ section.settings.padding-bottom-767 }}px;
      margin-top: {{ section.settings.margin-top-767 }}px;
      margin-bottom: {{ section.settings.margin-bottom-767 }}px;  
    }
  }
  @media screen and (max-width: 575px) {
    .ecom-circle-wrapper {
      padding-top: {{ section.settings.padding-top-575 }}px;
      padding-bottom: {{ section.settings.padding-bottom-575 }}px;
      margin-top: {{ section.settings.margin-top-575 }}px;
      margin-bottom: {{ section.settings.margin-bottom-575 }}px;  
    }
  }
.ecom-circle-wrapper{
  width:100%;
  background-color: {{ section.settings.bg_color }};
  display:flex;
  justify-content:center;
}

.ecom-circle-container{
  position:relative;
  width:800px;
  height:500px;
}

/* Center Circle */
.ecom-center{
  position:absolute;
  top:50%;
  left:50%;
  transform:translate(-50%,-50%);
  width:180px;
  height:180px;
  background:#19c6d4;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  box-shadow:0 0 0 15px rgba(255,255,255,0.08);
}

.ecom-center-inner{
  width:140px;
  height:140px;
  background-color: {{ section.settings.content_bg_color }};
  border-radius:50%;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding:10px;
}

.ecom-center-inner h3{
  font-size:16px;
  margin:8px 0 0;
  font-weight:600;
  color: {{ section.settings.content_color }};
}

/* Nodes */
.ecom-node{
  position:absolute;
  width:260px;
  display:flex;
  align-items:center;
  gap:12px;
}

/* Box */
.ecom-node-box{
  background:{{ section.settings.content_bg_color }};
  border-radius:50px;
  padding:10px 18px;
  display:flex;
  align-items:center;
  gap:10px;
  box-shadow:0 4px 15px rgba(0,0,0,0.1);
  min-width:220px;
}

.ecom-node-icon{
  width:36px;
  height:36px;
  background-color: {{ section.settings.highlight_color }};
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
}

.ecom-node-icon img{
  width:18px;
  height:18px;
  object-fit:contain;
}

.ecom-node-text{
  font-size:14px;
  font-weight:600;
  color: {{ section.settings.content_color }};
  white-space:nowrap;
}

/* Lines */
.ecom-node-line{
  width:60px;
  height:2px;
  background:#19c6d4;
}

/* ===== Positioning (Equal Spacing) ===== */

/* 1 - Top Left */
.ecom-node-1{
  top:5%;
  left:5%;
  flex-direction:row-reverse;
}

/* 2 - Left Center */
.ecom-node-2{
  top:45%;
  left:0;
  flex-direction:row-reverse;
}

/* 3 - Bottom Left */
.ecom-node-3{
  bottom:5%;
  left:5%;
  flex-direction:row-reverse;
}

/* 4 - Top Right */
.ecom-node-4{
  top:5%;
  right:5%;
}

/* 5 - Right Center */
.ecom-node-5{
  top:45%;
  right:0;
}

/* 6 - Bottom Right */
.ecom-node-6{
  bottom:5%;
  right:5%;
}

/* ===== Responsive System ===== */

/* Tablet */
@media(max-width: 1024px){
  .ecom-circle-container{
    width:100%;
    max-width:700px;
    height:480px;
  }

  .ecom-node{
    width:220px;
  }

  .ecom-node-box{
    min-width:200px;
    padding:8px 14px;
  }

  .ecom-node-text{
    font-size:13px;
  }
}

/* Mobile Layout Switch */
@media(max-width: 768px){
  .ecom-circle-container{
    position:relative;
    width:100%;
    height:auto;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:24px;
  }

  /* Center becomes normal block */
  .ecom-center{
    position:relative;
    transform:none;
    top:auto;
    left:auto;
    margin-bottom:20px;
  }

  /* Nodes stack vertically */
  .ecom-node{
    position:relative;
    width:100%;
    max-width:360px;
    flex-direction:row !important;
    justify-content:flex-start;
  }

  .ecom-node-line{
    display:none;
  }

  .ecom-node-box{
    width:100%;
    border-radius:16px;
    min-width:unset;
    justify-content:flex-start;
  }

  /* Reset absolute positions */
  .ecom-node-1,
  .ecom-node-2,
  .ecom-node-3,
  .ecom-node-4,
  .ecom-node-5,
  .ecom-node-6{
    top:auto;
    left:auto;
    right:auto;
    bottom:auto;
  }
}

/* Small Mobile */
@media(max-width: 480px){

  .ecom-center{
    width:140px;
    height:140px;
  }

  .ecom-center-inner{
    width:110px;
    height:110px;
  }

  .ecom-center-inner h3{
    font-size:14px;
  }

  .ecom-node-text{
    font-size:13px;
  }

  .ecom-node-icon{
    width:32px;
    height:32px;
  }

  .ecom-node-icon img{
    width:16px;
    height:16px;
  }
}

</style>

