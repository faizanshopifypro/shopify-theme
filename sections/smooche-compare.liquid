{{ 'smooche-phase5.css' | asset_url | stylesheet_tag }}

<section class="smooche-compare">
  <div class="smooche-compare__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="smooche-compare__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <table class="smooche-compare-table">
      <thead>
        <tr>
          <th></th>
          <th class="col-highlight"><span>{{ section.settings.brand_label }}</span></th>
          <th>{{ section.settings.others_label }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for block in section.blocks -%}
          <tr {{ block.shopify_attributes }}>
            <td>{{ block.settings.feature }}</td>
            <td class="col-highlight">
              <span class="smooche-compare__icon smooche-compare__icon--yes" aria-label="Yes">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="12" cy="12" r="12" fill="#df8096"/>
                  <path d="M7 12.5l3.2 3.2L17 8.8" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </td>
            <td>
              <span class="smooche-compare__icon smooche-compare__icon--no" aria-label="No">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <circle cx="10" cy="10" r="10" fill="#e0e0e0"/>
                  <path d="M7 7L13 13M13 7L7 13" stroke="white" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </span>
            </td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
  </div>
</section>

{% schema %}
{
  "name": "Smooche compare",
  "tag": "section",
  "class": "section-smooche-compare",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why smooche?"
    },
    {
      "type": "text",
      "id": "brand_label",
      "label": "Brand column label",
      "default": "SMOOCHE"
    },
    {
      "type": "text",
      "id": "others_label",
      "label": "Others column label",
      "default": "Others"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Feature row",
      "settings": [
        {
          "type": "text",
          "id": "feature",
          "label": "Feature",
          "default": "Adapts to skin tone"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Smooche compare",
      "blocks": [
        { "type": "row", "settings": { "feature": "Adapts to skin tone" } },
        { "type": "row", "settings": { "feature": "SPF 15" } },
        { "type": "row", "settings": { "feature": "Lasts 16+ hours" } },
        { "type": "row", "settings": { "feature": "Feels lightweight" } },
        { "type": "row", "settings": { "feature": "No settling in fine lines" } }
      ]
    }
  ]
}
{% endschema %}
