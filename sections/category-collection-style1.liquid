{{ 'category-collection-style1.css' | asset_url | stylesheet_tag }}
<div class="category-collection-style section-{{ section.id }}-padding d-inline-block  {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
  <div class="{{ section.settings.section_width }}">
    <div class="main-collection-item main-collection-item--{{ section.settings.text_alignment }}">
      {% if section.settings.heading-img != blank or section.settings.main_subheading != blank or section.settings.main_heading != blank or section.settings.main_paragraph != blank %}
        <div class="collection_title_wrap title_bottom_margin">
          {% if section.settings.heading-img != blank %}
            <div class="heading-img w-100 {{ section.settings.text_alignment }}">
              <img src="{{ section.settings.heading-img | img_url: 'master' }}" alt="slider-img" class="w-100" loading="eager">
            </div>
          {% endif %}
          {% if section.settings.main_subheading != blank %}
            <div class="theme_main_subheading">{{ section.settings.main_subheading }}</div>
          {% endif %}
          {% if section.settings.main_heading != blank %}
            <div class="theme_main_heading h2">{{ section.settings.main_heading }}</div>
          {% endif %}
          {% if section.settings.main_paragraph != blank %}
            <p class="theme_main_description">{{ section.settings.main_paragraph }}</p>
          {% endif %}
        </div>
      {% endif %}
      <div class="category_style_wrapper">
        <div class="main-collections-list-wrapper swiper-container"
          data-desktop="{{ section.settings.collection-desktop }}" data-largeTablet="{{ section.settings.collection-large-tablet }}" data-tablet="{{ section.settings.collection-tablet }}" 
          data-mobile="{{ section.settings.collection-mobile }}" data-autoplay="{{ section.settings.autoplay-enable }}"
          data-speed="{{ section.settings.speed }}" data-loop="{{ section.settings.loop }}">
          <div
            class="collection-list swiper-wrapper">
            {% for block in section.blocks %}
            {% if block.type == 'collection' %}
            {%- assign featured_collection = collections[block.settings.collection] -%}
            {%- assign featured_image = block.settings.image -%}
            {%- assign collectionTitle = featured_collection.title | default: 'Collection' -%}
            <div class="main-collection-list swiper-slide" {{ block.shopify_attributes }}>
              <div class="collection-{{ block.id }} collection-card__image ">
                <div class="collection-main-image">
                  <a {% if featured_collection.url==blank %} role="link" aria-disabled="true" {% else %}
                    href="{{ featured_collection.url }}" {% endif %} aria-label="{{ block.settings.title }}">
                    {%- if featured_image != blank -%}
                      <div class="media media--transparent ratio" style="--ratio-percent: 129.278%">
                        {{ featured_image | image_url: width: 1920 | image_tag : loading: 'lazy', class: 'w-100' }}
                      </div>
                    {% else %}
                      <div class="media media--transparent ratio" style="--ratio-percent: 129.278%">
                        {%- capture current -%}{%- cycle 1, 2, 3, 4, 5, 6 -%}{%- endcapture -%}
                        {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                      </div>
                {%- endif -%}
                  </a>
                </div>
              </div>
              <a {% if featured_collection.url==blank %} role="link" aria-disabled="true" {% else %}
                href="{{ featured_collection.url }}" {% endif %} class="collection-name" aria-label="{{ block.settings.title }}">
                <div class="collection-name-wrapper">
                  <div class="h3">
                    {% if block.settings.title != blank %}
                      {{ block.settings.title }}
                        {% else %}
                      {{ collectionTitle }}
                    {% endif %}
              </div>
                </div>
              </a>
            </div>
            {% endif %}
            {% endfor %}
          </div>
          {% if section.settings.arrows and section.settings.enable_desktop_slider %}
          <div class="swiper-buttons">
            <div class="content-buttons">
              <div class="swiper-button-next category-swiper-button-next">{% render 'icon-right' %}</div>
              <div class="swiper-button-prev category-swiper-button-prev">{% render 'icon-left' %}</div>
            </div>
          </div>
          {% endif %}
          {% if section.settings.dots and section.settings.enable_desktop_slider -%}
          <div class="swiper-pagination category-swiper-pagination" id="swiper-pagination-{{section.id}}" style="position: inherit;"></div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% style %}
  .category-collection-style .main-collection-list:hover .collection-name-wrapper .h3{
    
  }
  .category-collection-style .heading-img.center{
    margin: 0 auto;
  }
  .category-collection-style .heading-img.right{
    margin: 0 0 0 auto;
  }
  .category-collection-style .collection_title_wrap .theme_main_heading {
    color: {{ section.settings.theme_heading_color }};
  }
  .category-collection-style .collection_title_wrap .theme_main_subheading {
    color: {{ section.settings.theme_subheading_color }};
    background: {{ section.settings.theme_subheading_bgcolor }};
  }
  {% if section.settings.theme_subheading_bgcolor == 'rgba(0,0,0,0)' %}
      .category-collection-style .collection_title_wrap .theme_main_subheading { 
        background-color: transparent;
        padding: 0px;
      }
  {% endif %}
  .category-collection-style .collection_title_wrap .theme_main_description{
    color: {{ section.settings.content_color }};
  }
  .category-collection-style .swiper-button-next,
  .category-collection-style .swiper-button-prev{
    border: 1px dashed {{ settings.button_bg }};
  }
  .category-collection-style .swiper-button-next svg path,
  .category-collection-style .swiper-button-prev svg path{
    color: {{ settings.button_bg }};
    stroke: {{ settings.button_bg }};
  }
  .category-collection-style .swiper-button-next:hover,
  .category-collection-style .swiper-button-prev:hover{
    border: 1px dashed {{ settings.button_hr_bg }};
  }
  .category-collection-style .swiper-button-next:hover svg path,
  .category-collection-style .swiper-button-prev:hover svg path{
    color: {{ settings.button_hr_bg }};
    stroke: {{ settings.button_hr_bg }};
  }
  .category-collection-style .swiper-pagination-bullet { 
    background: {{ settings.theme_dots }}; 
  }  
  .category-collection-style .swiper-pagination-bullet.swiper-pagination-bullet-active { 
    background: {{ settings.theme_dots_active }};
  }
  .category-collection-style .collection-name-wrapper .h3{
    color: {{ section.settings.collection-name-color }};
  }
  .category-collection-style .main-collection-list:hover .collection-name-wrapper .h3{
    color: {{ section.settings.collection-hr-name-color }};
  }
  {% for block in section.blocks %}
    {% if block.type == 'collection' %}
      .collection-{{ block.id }}.collection-card__image:before {
        background-image: url({% if block.settings.back-img != blank %} {{ block.settings.back-img | img_url: 'master' }} {% endif %});
      }
    {% endif %}
  {% endfor %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding-top }}px;
    padding-bottom: {{ section.settings.padding-bottom }}px;
    margin-top: {{ section.settings.margin-top }}px;
    margin-bottom: {{ section.settings.margin-bottom }}px;
    background-color: {{ section.settings.bg_color }};
  }
  @media screen and (max-width: 1429px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding-top-1429 }}px;
      padding-bottom: {{ section.settings.padding-bottom-1429 }}px;
      margin-top: {{ section.settings.margin-top-1429 }}px;
      margin-bottom: {{ section.settings.margin-bottom-1429 }}px;
    }
  }
  @media screen and (max-width: 1199px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding-top-1199 }}px;
      padding-bottom: {{ section.settings.padding-bottom-1199 }}px;
      margin-top: {{ section.settings.margin-top-1199 }}px;
      margin-bottom: {{ section.settings.margin-bottom-1199 }}px;
    }
  }
  @media screen and (max-width: 991px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding-top-991 }}px;
      padding-bottom: {{ section.settings.padding-bottom-991 }}px;
      margin-top: {{ section.settings.margin-top-991 }}px;
      margin-bottom: {{ section.settings.margin-bottom-991 }}px;
    }
  }
  @media screen and (max-width: 767px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding-top-767 }}px;
      padding-bottom: {{ section.settings.padding-bottom-767 }}px;
      margin-top: {{ section.settings.margin-top-767 }}px;
      margin-bottom: {{ section.settings.margin-bottom-767 }}px;  
    }
  }
  @media screen and (max-width: 575px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding-top-575 }}px;
      padding-bottom: {{ section.settings.padding-bottom-575 }}px;
      margin-top: {{ section.settings.margin-top-575 }}px;
      margin-bottom: {{ section.settings.margin-bottom-575 }}px;  
    }
  }
{% endstyle %}

